# ==============================================================================
# MODISH7 — SALON PARTNER PORTAL CONFIGURATION
# ==============================================================================

# Server Port
PORT=5173

# JWT Authentication Secret (change in production)
JWT_SECRET=modish7_salon_portal_secret_key_prod_2026_xyz

# Local Database File Path (defaults to ./data/modish7.db)
DATABASE_PATH=./data/modish7.db

# ------------------------------------------------------------------------------
# RAZORPAY PAYMENT GATEWAY (INDIA)
# Generate from: https://dashboard.razorpay.com/#/access-keys
# ------------------------------------------------------------------------------
# Test keys format: rzp_test_xxxxxxxxxxxxxx
# Live keys format: rzp_live_xxxxxxxxxxxxxx
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ------------------------------------------------------------------------------
# GOOGLE OAUTH 2.0 (CONTINUE WITH GOOGLE)
# Generate from: https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:5173/api/auth/google/callback
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
APP_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# SUPABASE CONFIGURATION (OPTIONAL IF USING CLOUD POSTGRESQL)
# ------------------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

